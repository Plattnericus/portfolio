{
  "name": "plattnericus-landing-page",
  "version": "0.1.0",
  "private": true,
  "description": "Premium Next.js landing page for Nexor / Plattnericus with GSAP motion, SEO, robots.txt and sitemap.xml.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
